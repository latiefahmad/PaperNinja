{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PaperNinja",
  "version": "1.0.1",
  "identifier": "com.paperninja.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PaperNinja",
        "width": 1100,
        "height": 780,
        "minWidth": 900,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: asset:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyN0Q0RjY2OTZBNUZFMEQKUldRTi9xV1daazk5b3NEek1jcERjT2NLTmxnd0swK0MvVWdBN0V3Uis1MjdLdXRmRmJucnQ4VWIK",
      "endpoints": [
        "https://github.com/latiefahmad/PaperNinja/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD-PARTY-LICENSES.md": "licenses/THIRD-PARTY-LICENSES.md",
      "../LICENSES/NOTICES.txt": "licenses/NOTICES.txt",
      "../LICENSES/LGPL-2.1.txt": "licenses/LGPL-2.1.txt",
      "../LICENSES/LGPL-3.0.txt": "licenses/LGPL-3.0.txt",
      "../LICENSES/GPL-3.0.txt": "licenses/GPL-3.0.txt",
      "../LICENSES/GPL-2.0.txt": "licenses/GPL-2.0.txt",
      "../LICENSES/Apache-2.0.txt": "licenses/Apache-2.0.txt",
      "../LICENSES/OFL-1.1.txt": "licenses/OFL-1.1.txt",
      "../LICENSES/Artistic-1.0.txt": "licenses/Artistic-1.0.txt",
      "../LICENSES/CC0-1.0.txt": "licenses/CC0-1.0.txt",
      "../LICENSES/GFDL-1.2.txt": "licenses/GFDL-1.2.txt",
      "../LICENSES/GFDL-1.3.txt": "licenses/GFDL-1.3.txt",
      "../LICENSES/GPL-1.0.txt": "licenses/GPL-1.0.txt",
      "../LICENSES/LGPL-2.0.txt": "licenses/LGPL-2.0.txt",
      "../LICENSES/MPL-1.1.txt": "licenses/MPL-1.1.txt",
      "../LICENSES/MPL-2.0.txt": "licenses/MPL-2.0.txt"
    },
    "linux": {
      "deb": {
        "conflicts": [
          "papercut",
          "paper-otter"
        ],
        "replaces": [
          "papercut",
          "paper-otter"
        ],
        "files": {
          "/usr/share/doc/paperninja/copyright": "../LICENSES/copyright"
        }
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "description": "PDF Document",
        "role": "Editor"
      }
    ],
    "category": "Productivity"
  }
}
